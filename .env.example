# ========================================================
# XENO AI-NATIVE CRM - ENVIRONMENT VARIABLES
# ========================================================

# --------------------------------------------------------
# 🤖 AI Agent & Integrations
# --------------------------------------------------------

# OpenRouter API Key (Required for the Autonomous Agent)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-
APIFY_API_KEY=
# --------------------------------------------------------
# 🐘 Database Configuration (Railway / External DB)
# --------------------------------------------------------

# The JDBC URL format is required for Java/Spring Boot.
# Notice the 'jdbc:' prefix, and that credentials are NOT in the URL!
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.railway.internal:5432/railway

# The username and password must be provided separately
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=